# Copy to .env in this directory (ignored by backend/.gitignore); never commit
# real client credentials. This is separate from backend/.env.
# Register a dedicated OAuth App at https://github.com/settings/applications/new.
# Run task backend:test:auth:github in an interactive terminal. The task prints
# an exact callback URL after creating an isolated local instance/connection.
# Save that callback URL in the OAuth App before pressing Enter. Complete GitHub
# sign-in and consent in the visible browser; do not paste a GitHub password here.
# Empty scopes suffice for public /user profile fields; no email/organization API
# is queried. Prefer a dedicated test OAuth App without previously granted scopes.
# The account must meet the configured age threshold for the success lifecycle.
LINGUAFLOW_GITHUB_CLIENT_ID=
LINGUAFLOW_GITHUB_CLIENT_SECRET=
LINGUAFLOW_GITHUB_MIN_ACCOUNT_AGE_DAYS=365
